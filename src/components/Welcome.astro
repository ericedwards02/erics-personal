---
import crescentIconSvg from "../assets/crescentcares-icon.svg?raw";
import meriviaIconSvg from "../assets/merivia-icon.svg?raw";
---

<div id="container" class="h-full">
    <main class="h-full flex justify-center">
        <section id="hero" class="flex flex-col items-start justify-center p-4">
            <header class="mb-6 flex w-full flex-wrap items-baseline justify-between gap-x-6">
                <h1 id="name" aria-label="ERIC EDWARDS">
                    {
                        [..."ERIC EDWARDS"].map((char) =>
                            char === " " ? (
                                " "
                            ) : (
                                <span class="tick" aria-hidden="true">
                                    <span class="glyph">{char}</span>
                                    <span class="glyph">{char}</span>
                                </span>
                            ),
                        )
                    }
                </h1>
                <a class="note email" href="mailto:hi@ericedwards.dev">hi@ericedwards.dev</a>
            </header>
            <h1>
                founding engineer at <a href="https://www.crescentcares.com/"
                    class="merivia-link"
                    ><span class="company-icon crescent-icon" set:html={crescentIconSvg} />Crescent</a
                >
            </h1>
            <p class="note">nonprofit fintech</p>
            <h1>
                prev. founding eng. at <a href="https://merivia.ai/"
                    class="merivia-link"
                    ><span class="company-icon merivia-icon" set:html={meriviaIconSvg} />Merivia</a
                >
            </h1>
            <p class="note mb-2">data infra for impact</p>
            <section id="links">
                <a id="github" href="https://github.com/ericedwards02">github</a
                >
                <a
                    id="linkedin"
                    href="https://www.linkedin.com/in/ericedwards02/"
                    >linkedin</a
                >
                <a
                    id="letterboxd"
                    href="https://letterboxd.com/erixedwards/"
                    >letterboxd</a
                >
            </section>
        </section>
    </main>
</div>

<script>
    import { animate } from "motion";

    const transition = { type: "spring", duration: 0.35, bounce: 0 } as const;
    const canHover = matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    for (const tick of document.querySelectorAll<HTMLElement>("#name .tick")) {
        let [visible, hidden] = tick.querySelectorAll<HTMLElement>(".glyph");
        let rolling = false;

        tick.addEventListener("pointerenter", async () => {
            if (rolling || !canHover.matches || reducedMotion.matches) return;
            rolling = true;

            await Promise.all([
                animate(
                    visible,
                    { transform: ["translateY(0%)", "translateY(70%)"], opacity: [1, 0], filter: ["blur(0px)", "blur(4px)"] },
                    transition,
                ),
                animate(
                    hidden,
                    { transform: ["translateY(-70%)", "translateY(0%)"], opacity: [0, 1], filter: ["blur(4px)", "blur(0px)"] },
                    transition,
                ),
            ]);

            [visible, hidden] = [hidden, visible];
            rolling = false;
        });
    }
</script>

<style>
    h1 {
        margin-top: 0.25em;
    }

    .note {
        color: oklch(55% 0.03 63);
    }

    .tick {
        position: relative;
        display: inline-block;
    }

    .tick .glyph:last-child {
        position: absolute;
        inset: 0;
        opacity: 0;
    }

    .email {
        text-decoration: none;
        transition: color 150ms;
    }

    .email:hover {
        color: oklch(40% 0.05 63);
    }

    #links {
        display: flex;
        gap: 16px;
        margin-inline-start: -12px;
    }

    #links a {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        color: oklch(60% 0.194 36);
        text-decoration: none;
        transition: color 150ms;
    }

    #links a:hover {
        color: oklch(50% 0.16 36);
    }

    .merivia-link {
        color: inherit;
        white-space: nowrap;
        text-decoration-line: underline;
        text-decoration-color: oklch(65% 0.04 63);
        text-decoration-thickness: 1.5px;
        text-underline-offset: 4px;
        transition: text-decoration-color 150ms;
    }

    .merivia-link:hover {
        text-decoration-color: oklch(40% 0.05 63);
    }

    .company-icon {
        display: inline-block;
        width: 1cap;
        height: 1cap;
        margin-right: 0.2em;
        color: oklch(65% 0.04 63);
        transition: color 150ms;
    }

    .merivia-link:hover .company-icon {
        color: oklch(40% 0.05 63);
    }

    .company-icon :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }

    .crescent-icon :global(path) {
        fill: currentColor;
    }

</style>
