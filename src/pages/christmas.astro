---
import Layout from "../layouts/layout.astro";
---

<Layout title="Eugene OR - Christmas 2025">
    <main>
        <h1>Eugene OR, Christmas 2025</h1>
        <h3>
            The following is a list of itinerary ideas to pull from, curated by
            Jordan and Sadie. 🎄
        </h3>

        <section>
            <h2>Stores</h2>
            <ul>
                <li>5th Street Market</li>
                <li>Bo's Wine Depot</li>
                <li>Buffalo Exchange</li>
                <li>Capella Market</li>
                <li>Eugene Gear Traders</li>
                <li>Kiva</li>
                <li>Mindy's Needle Point Factory</li>
                <li>Oak St Vintage</li>
                <li>SARA Treasures</li>
                <li>Sundance</li>
                <li>The Racks</li>
                <li>Time Travelers</li>
                <li>Trash and Treasures</li>
            </ul>
        </section>

        <section>
            <h2>Record Stores</h2>
            <ul>
                <li>House of Records</li>
                <li>Moon Rocks</li>
            </ul>
        </section>

        <section>
            <h2>Book Stores</h2>
            <ul>
                <li>Smith Family Bookstore</li>
                <li>Tsunami Books</li>
            </ul>
        </section>

        <section>
            <h2>Museum</h2>
            <ul>
                <li>Jordan Schnitzer Museum of Art</li>
            </ul>
        </section>

        <section>
            <h2>Outside Things</h2>
            <ul>
                <li>Dorris Ranch</li>
                <li>Mount Pisgah Arboretum</li>
                <li>Pacific Ocean</li>
                <li>Rock Gym</li>
            </ul>
        </section>

        <section>
            <h2>Coffee</h2>
            <ul>
                <li>Acorn Cafe</li>
                <li>Cafe Pacori</li>
                <li>Community Cup Coffee</li>
                <li>Equano Coffee</li>
                <li>Farmers Union</li>
                <li>Palace</li>
            </ul>
        </section>

        <section>
            <h2>Bakeries</h2>
            <ul>
                <li>Hideaway</li>
                <li>Noisette Pastry Kitchen</li>
            </ul>
        </section>

        <section>
            <h2>Restaurants</h2>
            <ul>
                <li>16 Tons Cafe</li>
                <li>Barry's Espresso Bakery & Deli</li>
                <li>El Jaguar</li>
                <li>JunkYard Dogs in Junction City</li>
                <li>Makoto Sushi</li>
                <li>Rye</li>
                <li>Tacovore</li>
                <li>The Davis / Bar</li>
                <li>Tiger Mama</li>
            </ul>
        </section>

        <section>
            <h2>Breweries</h2>
            <ul>
                <li>Beer Garden</li>
                <li>Beer Station in Junction City</li>
                <li>Plank Town</li>
                <li>The Bier Stein</li>
            </ul>
        </section>

        <section>
            <h2>Bars</h2>
            <ul>
                <li>Bar Purlieu</li>
                <li>Crow and Cart</li>
                <li>Pint Pot Public</li>
                <li>Whiskey Lab</li>
            </ul>
        </section>
    </main>

    <style>
        main {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
            font-family:
                system-ui,
                -apple-system,
                sans-serif;
        }

        h1 {
            margin-bottom: 2rem;
        }

        section {
            margin-top: 1rem;
            margin-bottom: 1rem;
        }

        h2 {
            margin-bottom: 0.5rem;
        }

        ul {
            margin-top: 0.5rem;
            padding-left: 1.5rem;
            font-weight: normal;
        }

        li {
            margin-bottom: 0.25rem;
            line-height: 1.5;
        }
    </style>
</Layout>
